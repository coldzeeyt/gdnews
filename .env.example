# Everything on this site works with zero configuration - Demonlist,
# Patch Notes, Daily/Weekly, Updates, Leaks and Upcoming all use public,
# keyless APIs (Pointercrate, Steam, GDBrowser) or self-maintained data
# files. The only optional piece is live creator status:

# YouTube Data API v3 (console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key)
# Without this, the Live page just shows everyone as offline.
YOUTUBE_API_KEY=
# Optional: minutes between live checks. Each pinned creator costs 100
# quota units per check, plus one more 100-unit search for the "everyone
# else streaming GD right now" discovery list on the Live page (default
# project quota is 10,000/day). Default is 180 (3h), tuned for the current
# 8 creators (~7,200 units/day) - raise it if you add more creators, lower
# it if you have extra quota and want fresher status.
YOUTUBE_LIVE_TTL_MINUTES=180

# Passcode for /admin (the live attempt-tracking panel). Numeric keypad
# entry on the page itself, but the value can be anything.
ADMIN_PASSCODE=08092013

# Where the admin panel's data (current session + logged attempts) is
# persisted. On Railway this should point at a mounted volume (e.g. /data)
# so it survives redeploys - locally it defaults to a .data/ folder in the
# repo root, which is fine for testing but is NOT persisted on Railway
# without a volume.
DATA_DIR=./.data

PORT=3000
