# All of these are optional - the site runs without them, it just shows the
# affected section as "not configured" until you add the keys.

# YouTube Data API v3 (console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key)
# Used for creator live status.
YOUTUBE_API_KEY=
# Optional: minutes between live checks. Each creator costs 100 quota units
# per check (default project quota is 10,000/day), so raise this if you add
# more creators or lower it if you have extra quota.
YOUTUBE_LIVE_TTL_MINUTES=10

# Reddit (reddit.com/prefs/apps -> create app -> type "script")
# Used for the Updates/Leaks/Upcoming feeds.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

PORT=3000
